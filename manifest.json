{
  "manifest_version": 3,
  "name": "Vinted -> Leboncoin - FIX Quota",
  "version": "1.7.5",
  "description": "Fix quota exceeded - IndexedDB + unlimitedStorage",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "*://*.vinted.fr/*",
    "*://*.vinted.com/*",
    "*://*.vinted.net/*",
    "*://*.leboncoin.fr/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.vinted.fr/*", "*://*.vinted.com/*"],
      "js": ["content-vinted.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.leboncoin.fr/deposer-une-annonce/*"],
      "js": ["content-leboncoin.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon.png"],
      "matches": ["*://*.vinted.fr/*", "*://*.leboncoin.fr/*"]
    }
  ]
}
