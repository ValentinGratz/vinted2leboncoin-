{
  "manifest_version": 3,
  "name": "Vinted -> Leboncoin",
  "version": "1.7.1",
  "description": "Fix quota exceeded",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.vinted.fr/*",
    "*://*.vinted.com/*",
    "*://*.leboncoin.fr/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.vinted.fr/*",
        "*://*.vinted.com/*"
      ],
      "js": [
        "content-vinted.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.leboncoin.fr/*"
      ],
      "js": [
        "content-leboncoin.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon.png",
        "icon128.png"
      ],
      "matches": [
        "*://*.vinted.fr/*",
        "*://*.leboncoin.fr/*"
      ]
    }
  ]
}